# Copy into an ignored .env or pass through your deployment environment.
PLATFORM_RELEASE=c7057f0f-refactor
# These must name the current directories, not fresh substitutes.
PLATFORM_STATE_DIR=/srv/bot-platform/application
PLATFORM_DATABASE_FILENAME=application.sqlite
PLATFORM_CHECKPOINT_DIR=/srv/bot-platform/checkpoints
PLATFORM_CHECKPOINT_FILENAME=checkpoints.sqlite
PLATFORM_RETRIEVAL_STATE_DIR=/srv/bot-platform/retrieval
PLATFORM_DATA_DIR=/srv/bot-platform/data
PLATFORM_ISMART_DOCS_DIR=/srv/bot-platform/docs/ismart
PLATFORM_WORKER_ENV_FILE=/srv/bot-platform/gv.env
PLATFORM_LEGACY_URL=http://host.docker.internal:8002/api
# Supply a generated private credential; never commit the real value.
PLATFORM_SERVICE_TOKEN=
# Empty keeps new conversations on the unchanged legacy host during rollout.
PLATFORM_WORKER_AGENT_IDS=
PLATFORM_STOP_GRACE_PERIOD=24h
